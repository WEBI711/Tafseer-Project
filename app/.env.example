# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://tafseer:tafseer@localhost:5433/tafseer

# LLM gateway. Names are prefixed on purpose: the developer shell may export
# its own OPENAI_API_KEY, which would shadow a plain name.
TAFSEER_LLM_KEY=
TAFSEER_LLM_BASE=https://openrouter.ai/api/v1
TAFSEER_EMBED_MODEL=openai/text-embedding-3-small
TAFSEER_CHAT_MODEL=glm-5.3-flash